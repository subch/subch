---
const { title, description = "Travis Schaefer's project hub." } = Astro.props;
// Primary nav is live things only; the quiet workshop row on the splash owns
// the rest. RC and Weather came off 2026-09-03 -- the pages still answer at
// their URLs, they are just not advertised.
const nav = [
  { href: '/', label: 'Home' },
  { href: 'https://music.subch.us', label: 'Music' },
  { href: 'https://play.subch.us', label: 'Games' },
  { href: 'https://mtg.subch.us', label: 'Commander' },
  { href: '/search/', label: 'No Baloney' },
];
const currentPath = Astro.url.pathname;
// Colourway: LAVA, picked by the owner 2026-09-22 out of four candidates
// (glacier, acid and brass are in git history if ever wanted back).
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0709" />
    <title>{title ? `${title} · subch.us` : 'subch.us'}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Monoton&family=Audiowide&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
  </head>
  <body>
    <!-- the sky: three slow glows behind everything, drawn, no artwork -->
    <div class="sky" aria-hidden="true">
      <i class="glow g1"></i><i class="glow g2"></i><i class="glow g3"></i>
    </div>

    <header class="bar">
      <a class="brand" href="/" title="subch.us">
        <svg class="sun" viewBox="0 0 64 64" aria-hidden="true">
          <defs>
            <linearGradient id="sunGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color:var(--y)" />
              <stop offset=".45" style="stop-color:var(--b)" />
              <stop offset="1" style="stop-color:var(--a)" />
            </linearGradient>
            <mask id="sunMask">
              <rect width="64" height="64" fill="#fff" />
              <rect x="0" y="36" width="64" height="2.5" fill="#000" />
              <rect x="0" y="42" width="64" height="3.5" fill="#000" />
              <rect x="0" y="49" width="64" height="4.5" fill="#000" />
              <rect x="0" y="57" width="64" height="7" fill="#000" />
            </mask>
          </defs>
          <circle cx="32" cy="32" r="28" fill="url(#sunGrad)" mask="url(#sunMask)" />
        </svg>
        <span class="wordmark">subch<span>.us</span></span>
      </a>
      <nav class="nav" aria-label="Sections">
        {nav.map((item) => (
          <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="foot wrap">
      <span>Built by Travis Schaefer in Texas · drawn, not generated</span>
      <a href="https://github.com/subch">github.com/subch</a>
    </footer>

  </body>
</html>

<style is:global>
  /* ------------------------------------------------------------------
     subch.us - the music.subch.us look (Audiowide + Monoton, drawn sky,
     striped sun, neon floor grid) in its own colourway. Near-black grounds
     always: the owner's main monitor is a TV that turns any saturated dark
     blue into electric blue, so blue lives only in faint glows. No raster
     art anywhere on the site (his call, 2026-09-22). DARK ONLY.

     ------------------------------------------------------------------ */
  :root {
    color-scheme: dark;
    --f-display: 'Audiowide', 'Barlow Condensed', sans-serif;
    --f-neon: 'Monoton', 'Audiowide', sans-serif;
    --f-body: 'IBM Plex Sans', 'Segoe UI', system-ui, sans-serif;
    --f-mono: 'IBM Plex Mono', 'Cascadia Mono', Consolas, monospace;
    --wrap: 1080px;
  }

  /* LAVA - his desk: ultraviolet in the background, red / orange / amber up front.
     Roles: --a primary neon, --b secondary, --c third accent, --y pale highlight,
     --g1/2/3 the sky glows, --scene the hero's drawn sunset. */
  :root {
    --ground: #0b0709; --panel: #140d10; --raised: #22161b; --line: #3a2530; --line-soft: #1f1418;
    --text: #fbf1ea; --muted: #d3b7ad; --faint: #8a6e6a; --ink: #1a0608;
    --a: #ff2e4d; --b: #ff7a3d; --c: #ffb347; --y: #ffe6c7;
    --g1: #6a2fd4; --g2: #ff2e4d; --g3: #3b3bd9;
    --scene: linear-gradient(180deg, #1c0a3a 0%, #5a1348 40%, #c72a3e 64%, #ff8a3d 80%, #0b0709 90%);
  }

  /* Legacy names the inner pages already speak (/rc, /data, /3d-printing,
     /search, /esp32-arduino). Mapped onto the roles so they inherit the
     colourway without touching them. */
  :root {
    --bg: var(--ground); --fg: var(--text);
    --paper: var(--text); --gold: var(--a); --gold-bright: var(--b); --gold-deep: var(--line);
    --border: var(--line); --accent: var(--a); --card-bg: var(--panel);
    --display: var(--f-display);
    --pill-planned: var(--raised); --pill-planned-fg: var(--muted);
    --pill-active: color-mix(in srgb, var(--a) 22%, transparent); --pill-active-fg: var(--a);
    --pill-archived: color-mix(in srgb, var(--b) 18%, transparent); --pill-archived-fg: var(--b);
    --pill-project: color-mix(in srgb, var(--c) 18%, transparent); --pill-project-fg: var(--c);
    --pill-shelf: var(--raised); --pill-shelf-fg: var(--muted);
    --pill-parts: color-mix(in srgb, var(--b) 18%, transparent); --pill-parts-fg: var(--b);
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { margin: 0; padding: 0; }
  html { background: var(--ground); }
  body {
    /* transparent, not --ground: body is not a stacking context, so its own
       background would paint OVER the z-index:-1 sky (the glows). The
       html element carries the ground colour instead. */
    background: transparent; color: var(--text);
    font: 15px/1.5 var(--f-body);
    min-height: 100vh; position: relative; overflow-x: hidden;
  }
  a { color: var(--a); }
  a:hover { color: var(--b); }
  img { display: block; }

  /* the sky */
  .sky { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .sky .glow { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .18; animation: drift 28s ease-in-out infinite alternate; }
  .sky .g1 { width: 48vw; height: 48vw; left: -14vw; top: -12vw; background: var(--g1); }
  .sky .g2 { width: 40vw; height: 40vw; right: -12vw; top: 20vh; background: var(--g2); animation-delay: -9s; animation-duration: 33s; }
  .sky .g3 { width: 44vw; height: 44vw; left: 28vw; bottom: -20vw; background: var(--g3); opacity: .08; animation-delay: -17s; animation-duration: 39s; }
  @keyframes drift { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(6vw, 5vh, 0) scale(1.12); } }
  @media (prefers-reduced-motion: reduce) { .sky .glow, .scene { animation: none !important; } }

  /* header */
  .bar { display: flex; align-items: center; gap: 14px; padding: 14px 16px; max-width: var(--wrap); margin: 0 auto; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .sun { width: 40px; height: 40px; flex: none; filter: drop-shadow(0 0 10px color-mix(in srgb, var(--a) 55%, transparent)); }
  .wordmark { font: 400 30px/1 var(--f-neon); letter-spacing: .02em; color: var(--a); text-shadow: 0 0 6px color-mix(in srgb, var(--a) 60%, transparent), 0 0 22px color-mix(in srgb, var(--a) 35%, transparent); }
  .wordmark span { color: var(--b); text-shadow: 0 0 6px color-mix(in srgb, var(--b) 60%, transparent), 0 0 22px color-mix(in srgb, var(--b) 35%, transparent); }
  .nav { margin-left: auto; display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
  .nav a { color: var(--muted); text-decoration: none; font: 400 12px var(--f-display); letter-spacing: .14em; text-transform: uppercase; padding: 7px 10px; border-radius: 5px; }
  .nav a:hover { color: var(--b); background: var(--raised); text-shadow: 0 0 8px color-mix(in srgb, var(--b) 55%, transparent); }
  .nav a[aria-current='page'] { color: var(--a); }

  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 16px; }
  main.wrap { padding-top: 8px; padding-bottom: 40px; min-height: 60vh; }

  h1, h2, h3 { font-family: var(--f-display); font-weight: 400; color: var(--text); }
  h2 {
    font: 400 22px/1.1 var(--f-display); letter-spacing: .1em; text-transform: uppercase; margin: 0 0 14px;
    background: linear-gradient(90deg, #fff 0%, var(--a) 45%, var(--b) 100%); -webkit-background-clip: text; background-clip: text; color: transparent;
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  h2 .sub { font: 500 14px var(--f-body); letter-spacing: 0; text-transform: none; color: var(--faint); -webkit-text-fill-color: var(--faint); }
  h3 { font: 400 12px var(--f-display); letter-spacing: .18em; text-transform: uppercase; color: var(--b); margin: 0 0 8px; }
  .block { margin-top: 42px; }

  /* buttons */
  .btn {
    display: inline-flex; align-items: center; height: 38px; padding: 0 18px; border-radius: 6px; text-decoration: none;
    background: linear-gradient(90deg, var(--a), var(--b)); color: var(--ink); font: 400 12px var(--f-display); letter-spacing: .16em; text-transform: uppercase;
    box-shadow: 0 0 18px color-mix(in srgb, var(--a) 35%, transparent);
  }
  .btn:hover { filter: brightness(1.12); color: var(--ink); }
  .btn.ghost { background: transparent; color: var(--text); border: 1px solid var(--line); box-shadow: none; }
  .btn.ghost:hover { border-color: var(--b); color: var(--b); }

  /* the neon floor grid, scrolling toward the viewer */
  .grid-floor {
    position: absolute; left: -20%; right: -20%; bottom: 0; height: 90px; z-index: 0; pointer-events: none;
    background:
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--a) 40%, transparent) 0 1px, transparent 1px 60px),
      repeating-linear-gradient(180deg, color-mix(in srgb, var(--a) 40%, transparent) 0 1px, transparent 1px 22px);
    transform: perspective(240px) rotateX(58deg); transform-origin: 50% 100%;
    mask-image: linear-gradient(180deg, transparent, #000 70%); -webkit-mask-image: linear-gradient(180deg, transparent, #000 70%);
    opacity: .6;
  }

  /* footer */
  .foot { padding: 20px 16px 40px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; color: var(--faint); font-size: 12px; border-top: 1px solid var(--line-soft); margin-top: 20px; }
  .foot a { color: var(--muted); text-decoration: none; }
  .foot a:hover { color: var(--b); }

  /* ---------- shared page furniture (inner pages) ---------- */
  main.wrap > h1 { font-size: 1.9rem; margin: 18px 0 0.25rem; line-height: 1.2; }
  .tagline { color: var(--muted); margin-top: 0; }
  .card-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: 1.5rem; }
  .card { border: 1px solid var(--line); background: var(--panel); border-radius: 12px; padding: 1rem 1.1rem; }
  .card h3 { margin: 0 0 0.35rem; font-size: 1rem; letter-spacing: 0; text-transform: none; color: var(--text); }
  .card p { margin: 0 0 0.6rem; color: var(--muted); font-size: 0.92rem; }
  .card a.repo-link { font-size: 0.85rem; }
  .pill { display: inline-block; font: 400 10px var(--f-display); text-transform: uppercase; letter-spacing: .14em; padding: 0.2rem 0.55rem; border-radius: 999px; margin-bottom: 0.5rem; }
  .pill-active, .pill-runner { background: var(--pill-active); color: var(--pill-active-fg); }
  .pill-planned { background: var(--pill-planned); color: var(--pill-planned-fg); }
  .pill-archived, .pill-retired { background: var(--pill-archived); color: var(--pill-archived-fg); }
  .pill-project { background: var(--pill-project); color: var(--pill-project-fg); }
  .pill-shelf { background: var(--pill-shelf); color: var(--pill-shelf-fg); }
  .pill-parts { background: var(--pill-parts); color: var(--pill-parts-fg); }
  .section { margin-top: 2.5rem; }
  .section h2 { font-size: 1.15rem; border-bottom: 1px solid var(--line); padding-bottom: 0.4rem; }
  .fork-list { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; padding: 0; margin: 0.75rem 0 0; list-style: none; font-size: 0.9rem; color: var(--muted); }
  .fork-list a { color: var(--muted); }
  .fork-list a:hover { color: var(--b); }

  @media (max-width: 760px) {
    .bar { flex-wrap: wrap; }
    .wordmark { font-size: 24px; }
    .nav { margin-left: 0; width: 100%; justify-content: flex-start; }
    .nav a { padding: 6px 7px; font-size: 11px; }
  }
</style>
