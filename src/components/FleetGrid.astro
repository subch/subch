---
import { coverPhoto, statusLabel, completeness } from '../lib/fleet.js';
const { vehicles } = Astro.props;
---
{vehicles.length === 0 ? (
  <p class="tagline">No vehicles logged yet.</p>
) : (
  <div class="fleet-grid">
    {vehicles.map((v) => {
      const photo = coverPhoto(v);
      const c = completeness(v);
      return (
        <a class="fleet-card" href={`/rc/${v.slug}/`}>
          <div class="fleet-photo">
            {photo ? (
              <img src={photo} alt={v.name} loading="lazy" />
            ) : (
              <span class="fleet-photo-empty">no photo yet</span>
            )}
            <span class={`pill pill-fleet pill-${v.status}`}>{statusLabel(v.status)}</span>
          </div>
          <div class="fleet-body">
            <h3>{v.name}</h3>
            <p class="fleet-class">{v.class || v.scale || '—'}</p>
            {v.summary && <p class="fleet-summary">{v.summary}</p>}
            <div class="fleet-meter" title={`${c.filled} of ${c.total} spec fields filled`}>
              <div class="fleet-meter-fill" style={`width:${c.pct}%`}></div>
            </div>
            <p class="fleet-meter-label">{c.pct}% spec'd</p>
          </div>
        </a>
      );
    })}
  </div>
)}

<style>
  .fleet-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    margin-top: 1.5rem;
  }
  .fleet-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    background: var(--card-bg);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .fleet-card:hover { border-color: var(--accent); }
  .fleet-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fleet-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fleet-photo-empty {
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pill-fleet {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    margin: 0;
  }
  .fleet-body { padding: 0.85rem 1rem 1rem; }
  .fleet-body h3 { margin: 0 0 0.15rem; font-size: 1.02rem; }
  .fleet-class {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .fleet-summary {
    margin: 0 0 0.7rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .fleet-meter {
    height: 4px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .fleet-meter-fill {
    height: 100%;
    background: var(--accent);
  }
  .fleet-meter-label {
    margin: 0.3rem 0 0;
    font-size: 0.72rem;
    color: var(--muted);
  }
</style>
