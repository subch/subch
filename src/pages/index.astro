---
import Base from '../layouts/Base.astro';
import LavaLamp from '../components/LavaLamp.astro';

// The splash is a launcher: live, fun things only. Workshop/reference pages
// live in the quiet row at the bottom. Everything on this page is drawn
// (CSS and inline SVG); no raster art, by the owner's rule of 2026-09-22.

// The three front doors: the big gradient-framed cards.
const doors = [
  {
    kicker: 'Instruments, effects and a sample crate',
    name: 'music.subch.us',
    href: 'https://music.subch.us',
    blurb: 'A Juno-shaped polysynth, an 808-shaped drum machine, a modular rack, a pedal-circuit simulator and a sample jam, all running in the browser on Rust compiled to WebAssembly. Plus what I am listening to right now.',
    foot: 'Six tools · no install · works on a phone',
  },
  {
    kicker: 'Board and card games',
    name: 'The Game Room',
    href: 'https://play.subch.us',
    blurb: 'Chess, checkers, Connect Four, Mancala, Crazy Eights and seven more, with real online tables: join by name, play friends on their own phones, stats that follow you. Plus two arcade cabinets out the back.',
    foot: 'Free play · no sign-ups · works on a TV remote',
  },
  {
    kicker: 'Magic: The Gathering',
    name: 'Commander',
    href: 'https://mtg.subch.us',
    blurb: 'Four-player Commander in the browser with every rule enforced and nothing to install. The Forge engine does the judging; you bring the deck.',
    foot: 'Members of the Discord only',
  },
];

// The music tools, one card each, all under music.subch.us.
const music = [
  { kicker: 'Polyphonic synthesizer', name: 'SUBCH-60', href: 'https://music.subch.us/subch60/', blurb: 'Six voices in the shape of the Juno-60: one oscillator a voice, a four-pole filter, the arpeggiator and the chorus that made it famous. Every slider explains itself.' },
  { kicker: 'Drum machine', name: 'SUBCH-808', href: 'https://music.subch.us/subch808/', blurb: 'Eleven voices built the way the TR-808 built them, a sixteen-step sequencer with accent and shuffle, and a knob explainer on every control. Bounce a beat to WAV.' },
  { kicker: 'Modular synthesizer', name: 'SUBCHange', href: 'https://music.subch.us/subchange/', blurb: 'Sixteen modules on a rack, patched with cables: oscillators, filters, envelopes, a step sequencer, delay and reverb. Share a patch as a link.' },
  { kicker: 'Guitar pedal circuits', name: 'Pedal Lab', href: 'https://music.subch.us/pedal/', blurb: 'Ten classic pedal circuits simulated part by part. Turn a knob, swap a diode, change a cap, and hear it; the scope and the frequency response show why.' },
  { kicker: 'Sample crate and jam', name: 'SUBCHannels', href: 'https://music.subch.us/subchannels/', blurb: 'An 8×8 pad grid of loops and one-shots locked to one clock, with a step sequencer and punch-in effects. Build your own grid from the crate.' },
  { kicker: 'Guitar', name: 'Capo Finder', href: 'https://music.subch.us/capo/', blurb: 'Open chord voicings, the shapes that sit next to them, and a capo finder: pick the key and the shapes you would rather play. Design and idea by Bryan Albee.' },
];

// Also live, smaller.
const more = [
  { kicker: 'Search', name: 'No Baloney', href: '/search/', blurb: 'A search engine tuned to skip the junk and find real answers.' },
  { kicker: 'Offline edition', name: 'Game Room · Road Trip', href: '/gameroom/', blurb: 'The pass-and-play Game Room: loads once, then works with zero signal, and syncs your stats home later.' },
  { kicker: 'Gran Turismo 7', name: 'Goon Turismo', href: 'https://goon-turismo.com', blurb: 'Our crew’s time-trial results and season standings.', external: true },
];

const workshop = [
  { name: '3D Printing', href: '/3d-printing/' },
  { name: 'ESP32 / Arduino', href: '/esp32-arduino/' },
  { name: 'Data Projects', href: '/data/' },
  { name: 'GitHub', href: 'https://github.com/subch' },
];
---
<Base title="Home" description="Synths, drum machines and pedal circuits in the browser, games for the family, a search engine that skips the junk, and the other things Travis Schaefer builds for fun.">
  <!-- ------------------------------------------------ hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="scene" aria-hidden="true"></div>
    <LavaLamp id="hero-lamp" class="scene-lamp" />
    <div class="hero-body">
      <p class="kicker">The Schaefer build shelf</p>
      <h1 id="hero-title">Things I built<br />for the fun of it.</h1>
      <p class="lede">
        Synths and drum machines that run in a browser tab, games for the family,
        a search engine that skips the junk. Everything here works right now. Pick one.
      </p>
      <div class="cta">
        <a class="btn" href="https://music.subch.us">Make some noise</a>
        <a class="btn ghost" href="https://play.subch.us">Play a game</a>
      </div>
    </div>
    <div class="grid-floor" aria-hidden="true"></div>
  </section>

  <!-- ------------------------------------------------ front doors -->
  <section class="block" id="doors">
    <h2>Front doors <span class="sub">the big three</span></h2>
    <div class="doors">
      {doors.map((d) => (
        <a class="door" href={d.href}>
          <span class="d-body">
            <span class="d-kicker">{d.kicker}</span>
            <span class="d-name">{d.name}</span>
            <span class="d-desc">{d.blurb}</span>
            <span class="d-foot">{d.foot}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ------------------------------------------------ music -->
  <section class="block" id="music">
    <h2>Music <span class="sub">instruments and effects, drawn and simulated, nothing installed</span></h2>
    <div class="cards">
      {music.map((m) => (
        <a class="tile" href={m.href}>
          <span class="t-kicker">{m.kicker}</span>
          <span class="t-name">{m.name}</span>
          <span class="t-desc">{m.blurb}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ------------------------------------------------ also live -->
  <section class="block" id="more">
    <h2>Also live <span class="sub">smaller things that work</span></h2>
    <div class="cards three">
      {more.map((m) => (
        <a class="tile" href={m.href} target={m.external ? '_blank' : undefined} rel={m.external ? 'noopener' : undefined}>
          <span class="t-kicker">{m.kicker}</span>
          <span class="t-name">{m.name}</span>
          <span class="t-desc">{m.blurb}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ------------------------------------------------ workshop -->
  <section class="block workshop" id="workshop">
    <h2>From the workshop <span class="sub">notes, parts lists, works in progress</span></h2>
    <ul>
      {workshop.map((w) => (
        <li><a href={w.href}>{w.name}</a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* ---------- hero: the drawn sunset panel, like the music hub's now-playing box ---------- */
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    margin-top: 12px; padding: 56px 40px 96px;
    border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--a) 14%, transparent), 0 30px 80px #00000088;
  }
  .scene {
    position: absolute; inset: 0; z-index: 0; opacity: .55;
    background: var(--scene);
    animation: push 22s ease-in-out infinite alternate; transform-origin: 70% 80%; will-change: transform;
  }
  @keyframes push { from { transform: scale(1); } to { transform: scale(1.06); } }
  .hero :global(.scene-lamp) {
    position: absolute; right: 9%; bottom: 8%; height: 92%; width: auto; z-index: 0;
    filter: drop-shadow(0 0 30px color-mix(in srgb, var(--a) 35%, transparent));
  }
  .hero-body { position: relative; z-index: 1; max-width: 560px; }
  .kicker { margin: 0 0 12px; font: 400 11px var(--f-display); letter-spacing: .24em; text-transform: uppercase; color: var(--b); text-shadow: 0 0 10px color-mix(in srgb, var(--b) 40%, transparent); }
  .hero h1 {
    margin: 0 0 14px; font: 400 clamp(30px, 5.4vw, 52px)/1.05 var(--f-display);
    text-shadow: 0 0 18px color-mix(in srgb, var(--a) 30%, transparent);
  }
  .hero h1 :global(br) { display: block; }
  .lede { margin: 0; max-width: 46ch; font-size: 16px; color: var(--text); text-shadow: 0 1px 8px #000c; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  /* ---------- front doors: gradient frame with a glow, the name big ---------- */
  .doors { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .door {
    display: flex; flex-direction: column; text-decoration: none; color: var(--text); border-radius: 18px; overflow: hidden; position: relative;
    background: linear-gradient(var(--panel), var(--panel)) padding-box, linear-gradient(135deg, var(--a), var(--b) 55%, var(--c)) border-box;
    border: 2px solid transparent;
    box-shadow: 0 0 30px color-mix(in srgb, var(--a) 14%, transparent), 0 20px 50px #00000066;
    transition: transform .15s, box-shadow .15s;
  }
  .door:hover { transform: translateY(-3px); box-shadow: 0 0 40px color-mix(in srgb, var(--a) 28%, transparent), 0 24px 60px #00000080; color: var(--text); }
  .door::after { content: "\2192"; position: absolute; right: 18px; top: 16px; font: 400 22px var(--f-display); color: var(--b); text-shadow: 0 0 10px color-mix(in srgb, var(--b) 55%, transparent); }
  .d-body { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px; flex: 1; }
  .d-kicker { font: 400 10px var(--f-display); letter-spacing: .22em; text-transform: uppercase; color: var(--b); }
  .d-name { font: 400 30px/1.1 var(--f-display); text-shadow: 0 0 14px color-mix(in srgb, var(--a) 30%, transparent); margin: 2px 0 4px; overflow-wrap: anywhere; }
  .d-desc { color: var(--muted); font-size: 14px; }
  .d-foot { color: var(--faint); font-size: 12px; margin-top: auto; padding-top: 8px; }

  /* ---------- tiles: the compact cards ---------- */
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
  .cards.three { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .tile {
    display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px;
    text-decoration: none; color: var(--text); background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
    transition: transform .15s, border-color .15s, box-shadow .15s;
  }
  .tile:hover { transform: translateY(-2px); border-color: var(--a); box-shadow: 0 0 20px color-mix(in srgb, var(--a) 22%, transparent); color: var(--text); }
  .t-kicker { font: 400 10px var(--f-display); letter-spacing: .18em; text-transform: uppercase; color: var(--b); }
  .t-name { font: 400 17px/1.25 var(--f-display); margin: 2px 0 4px; }
  .t-desc { color: var(--muted); font-size: 13px; line-height: 1.45; }

  /* ---------- workshop row ---------- */
  .workshop ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .workshop li a {
    display: inline-block; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line);
    color: var(--muted); text-decoration: none; font: 400 11px var(--f-display); letter-spacing: .14em; text-transform: uppercase;
    transition: color .14s, border-color .14s;
  }
  .workshop li a:hover { color: var(--b); border-color: var(--b); }

  @media (max-width: 760px) {
    .hero { padding: 36px 20px 84px; }
    .hero { padding-bottom: 150px; }
    .hero-body { max-width: 100%; }
    .hero :global(.scene-lamp) { height: 44%; bottom: 10%; right: 4%; opacity: .75; }
  }
  @media (prefers-reduced-motion: reduce) {
    .door, .tile { transition: none; }
    .door:hover, .tile:hover { transform: none; }
  }
</style>
