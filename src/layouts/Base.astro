---
import '@fontsource/rye/400.css';
const { title, description = "Travis Schaefer's project hub." } = Astro.props;
// Primary nav is live things only; the quiet workshop row on the splash owns
// the rest. RC and Weather came off 2026-09-03 -- the pages still answer at
// their URLs, they are just not advertised.
const nav = [
  { href: '/', label: 'Home' },
  { href: 'https://play.subch.us', label: 'Game Room' },
  { href: '/search/', label: 'No Baloney' },
  { href: '/mtg/', label: 'Commander' },
];
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23140D08'/%3E%3Ctext x='50' y='70' text-anchor='middle' font-family='Georgia,serif' font-weight='700' font-size='58' fill='%23D9A431'%3Es.%3C/text%3E%3C/svg%3E" />
    <meta name="theme-color" content="#140D08" />
    <title>{title ? `${title} · subch.us` : 'subch.us'}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">subch<span>.us</span></a>
        <nav>
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap">
      <p class="foot-line">
        <span>Built by Travis Schaefer in Texas</span>
        <span class="foot-dot">·</span>
        <a href="https://github.com/subch">github.com/subch</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* ------------------------------------------------------------------
     Palette. These are the shipped tokens from arcade-art/STYLE.md sec 7 --
     the same ones the arcade, the Game Room and the dashboard spend. Do not
     hand-pick a hex below this block; add a token here instead (sec 10 item 4).

     DARK ONLY, decided 2026-09-03. This world is warm and dark and there is
     no light colourway of it. `color-scheme: dark` tells the browser so, and
     there is deliberately no prefers-color-scheme block anywhere in the site:
     a visitor on a light-set OS gets this, exactly as they do on
     play.subch.us and the dashboard.
     ------------------------------------------------------------------ */
  :root {
    color-scheme: dark;

    --ground: #140d08;        /* deep timber -- the page ground */
    --panel: #241a14;         /* surfaces, cards */
    --paper: #f7f1e6;         /* text */
    --gold: #d9a431;          /* the accent, everywhere */
    --gold-bright: #f5c95b;   /* lit edges, lamplight */
    --gold-deep: #8a6417;     /* shadowed gilt -- rules and borders */
    --oxblood: #7a2e22;
    --felt: #2b6647;

    /* The page ground. One line to swap the colourway; the file has to be in
       install-world.py's `subch` manifest or it will not be there to load. */
    --wallpaper: url('/art/wallpaper/wattle.webp');

    /* Legacy names the inner pages already speak. Kept so /rc, /data,
       /3d-printing and the rest inherit this palette without touching them. */
    --bg: var(--ground);
    --fg: var(--paper);
    --muted: #b8a58c;
    --border: rgba(217, 164, 49, 0.22);
    --accent: var(--gold);
    --card-bg: var(--panel);

    --display: 'Rye', Georgia, 'Times New Roman', serif;
    --wrap: 860px;

    /* status pills, in the world's colours rather than the old blue-grey set */
    --pill-planned: rgba(184, 165, 140, 0.14);
    --pill-planned-fg: #c4b39a;
    --pill-active: rgba(43, 102, 71, 0.32);
    --pill-active-fg: #7fc79e;
    --pill-archived: rgba(122, 46, 34, 0.3);
    --pill-archived-fg: #d99a86;
    --pill-project: rgba(217, 164, 49, 0.16);
    --pill-project-fg: var(--gold-bright);
    --pill-shelf: rgba(184, 165, 140, 0.14);
    --pill-shelf-fg: #c4b39a;
    --pill-parts: rgba(122, 46, 34, 0.3);
    --pill-parts-fg: #d99a86;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  html { background: var(--ground); }

  /* ------------------------------------------------------------------
     The wallpaper. Two fixed layers behind everything:

       ::before  the tile itself
       ::after   a scrim that sits it back so text can live on it

     `position: fixed` and NOT `background-attachment: fixed` -- the latter
     re-composites the whole background every scroll frame and buys nothing
     once the layer is already fixed (STYLE.md sec 10, 2026-09-01 item 6).

     `background` stays off `body` so these negative-z layers are not painted
     over by it. If anything here ever stops showing, read what is PAINTED
     with document.elementFromPoint() -- a correct computed style under an
     opaque wrapper is the exact way this was lost once before.
     ------------------------------------------------------------------ */
  body {
    background: transparent;
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.5;
    position: relative;
    min-height: 100vh;
  }
  body::before,
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  body::before {
    background-image: var(--wallpaper);
    /* 420px, not the tile's native 768. Measured on screen: at 768 the
       branches are so large that a 1280px viewport shows barely one and a
       half motifs and it reads as a photograph of leaves; at 420 it reads as
       a repeating paper, which is what it is. */
    background-size: 420px 420px;
    background-repeat: repeat;
    opacity: 0.95;
  }
  body::after {
    /* Sits the pattern back so text can live on it. The scrim is a COOL DEEP
       GREEN-BLACK, not the timber brown it started as: washing #140d08 over a
       forest-green tile at the strength text needs turned the whole page
       muddy brown and threw the colourway away. Darkest across the reading
       column, thinnest at the margins, so the paper is still paper where
       nothing is written on it. */
    background:
      linear-gradient(90deg,
        rgba(9, 18, 13, 0.10),
        rgba(9, 18, 13, 0.62) 22%,
        rgba(9, 18, 13, 0.68) 78%,
        rgba(9, 18, 13, 0.10)),
      linear-gradient(180deg, rgba(9, 18, 13, 0.3), rgba(9, 18, 13, 0.55));
  }
  @media (max-width: 700px) {
    /* A tile sized for a desktop wall is a close-up on a phone -- 420px on a
       390px viewport shows one motif and stops reading as a repeat. Shrink
       the paper with the room, and lean on the scrim harder because there
       are no side margins left for the pattern to breathe in. */
    body::before { background-size: 250px 250px; }
    body::after {
      background: linear-gradient(180deg, rgba(9, 18, 13, 0.62), rgba(9, 18, 13, 0.74));
    }
  }

  h1, h2, h3, .brand { font-family: var(--display); font-weight: 400; }
  h1, h2, h3 { color: var(--paper); letter-spacing: 0.01em; }
  a { color: var(--gold); }
  a:hover { color: var(--gold-bright); }

  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* ---------- chrome ---------- */
  .site-header {
    border-bottom: 1px solid var(--border);
    background: rgba(20, 13, 8, 0.72);
    backdrop-filter: blur(2px);
  }
  .site-header .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .brand {
    font-size: 1.3rem;
    color: var(--paper);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .brand span { color: var(--gold); }
  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.15rem;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.95rem;
    padding: 0.35rem 0.1rem;
  }
  nav a:hover { color: var(--paper); }
  nav a[aria-current='page'] {
    color: var(--gold-bright);
    border-bottom: 2px solid var(--gold);
  }

  main.wrap {
    padding-top: 2rem;
    padding-bottom: 3rem;
    min-height: 60vh;
  }
  footer.wrap {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    padding-bottom: 2rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .foot-line {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .foot-dot { color: var(--gold-deep); }

  /* ---------- shared page furniture (inner pages) ---------- */
  h1 { font-size: 1.9rem; margin-bottom: 0.25rem; line-height: 1.2; }
  .tagline { color: var(--muted); margin-top: 0; }
  .card-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    margin-top: 1.5rem;
  }
  .card {
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  .card h3 { margin: 0 0 0.35rem; font-size: 1rem; }
  .card p { margin: 0 0 0.6rem; color: var(--muted); font-size: 0.92rem; }
  .card a.repo-link { font-size: 0.85rem; }
  .pill {
    display: inline-block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }
  .pill-active { background: var(--pill-active); color: var(--pill-active-fg); }
  .pill-planned { background: var(--pill-planned); color: var(--pill-planned-fg); }
  .pill-archived { background: var(--pill-archived); color: var(--pill-archived-fg); }
  /* fleet statuses */
  .pill-runner { background: var(--pill-active); color: var(--pill-active-fg); }
  .pill-project { background: var(--pill-project); color: var(--pill-project-fg); }
  .pill-shelf { background: var(--pill-shelf); color: var(--pill-shelf-fg); }
  .pill-parts { background: var(--pill-parts); color: var(--pill-parts-fg); }
  .pill-retired { background: var(--pill-archived); color: var(--pill-archived-fg); }
  .section { margin-top: 2.5rem; }
  .section h2 {
    font-size: 1.15rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
    color: var(--gold-bright);
  }
  .fork-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 0;
    margin: 0.75rem 0 0;
    list-style: none;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .fork-list a { color: var(--muted); }
  .fork-list a:hover { color: var(--gold-bright); }
</style>
