---
// Standalone layout for the /mtg subsite. Deliberately does not use Base.astro:
// this corner of the site has its own identity rather than the subch.us chrome.
import '@fontsource/cinzel/700.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';

const {
  title,
  description = 'Commander night on our own XMage server. Free, no account, rules enforced.',
  wide = false,
} = Astro.props;

const nav = [
  { href: '/mtg/', label: 'Home' },
  { href: '/mtg/decks/', label: 'All decks' },
  { href: '/mtg/#convert', label: 'Convert a list' },
];
const path = Astro.url.pathname;
const COLORS = ['W', 'U', 'B', 'R', 'G'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · The Pod` : 'The Pod · Commander'}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? 'The Pod'} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0a0a0e" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230a0a0e'/%3E%3Ccircle cx='30' cy='34' r='11' fill='%23f6e6bd'/%3E%3Ccircle cx='70' cy='34' r='11' fill='%234b93d8'/%3E%3Ccircle cx='50' cy='50' r='11' fill='%239b7fc0'/%3E%3Ccircle cx='30' cy='68' r='11' fill='%23e2593c'/%3E%3Ccircle cx='70' cy='68' r='11' fill='%2355a765'/%3E%3C/svg%3E"
    />
    <link rel="stylesheet" href="/mtg/pod.css" />
    {wide && <style is:global>{`:root { --wrap: 1280px; }`}</style>}
  </head>
  <body>
    <header class="pod-header">
      <div class="wrap">
        <a class="brand" href="/mtg/">
          <span class="pips">
            {COLORS.map((c) => <span class={`pip pip-${c}`}>{c}</span>)}
          </span>
          The Pod
        </a>
        <nav class="pod-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="pod-footer">
      <div class="wrap">
        <p style="margin:0">
          Commander night at <a href="https://subch.us">subch.us</a> ·
          server <code>mtg.subch.us:17171</code>
        </p>
        <p class="credits">
          Card images and names are property of Wizards of the Coast. This is
          unofficial fan content, not affiliated with or endorsed by Wizards.
          Deck data from <a href="https://mtgjson.com">MTGJSON</a>, card data
          from <a href="https://scryfall.com">Scryfall</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
