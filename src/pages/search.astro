---
import Base from '../layouts/Base.astro';
import searchConfig from '../data/search-config.json';
import data from '../data/repos.json';

const configured = Boolean(searchConfig.searchEngineId);
const category = data.categories.find((c) => c.slug === 'search');
---
<Base
  title="No Baloney"
  description="Curated search that surfaces primary and authoritative sources instead of AI-generated SEO content-farm results."
>
  <div class="deli-page">
    <div class="deli-checker" aria-hidden="true"></div>

    <h1 class="deli-title">No Baloney<span class="deli-title-sub">🥪 fresh sources, thinly sliced</span></h1>
    <p class="tagline deli-tagline">
      Search results from a curated allowlist of trusted domains — universities, .gov sites, manufacturers — instead of AI-written content-farm SEO pages.
    </p>

    {!configured && (
      <div class="deli-card" style="margin-top: 1.5rem;">
        <h3>Not configured yet</h3>
        <p>
          This page embeds a <a href="https://programmablesearchengine.google.com/">Google Programmable Search Engine</a>,
          which needs to be created first. See the
          {' '}<a href="https://github.com/subch/no-baloney#setup-one-time-in-googles-dashboard--not-something-i-can-do-for-you">setup steps</a>
          {' '}in the <a href="https://github.com/subch/no-baloney">no-baloney</a> repo, then fill in <code>src/data/search-config.json</code>.
        </p>
      </div>
    )}

    {configured && (
      <div class="deli-widget-card">
        <div class="gcse-search"></div>
      </div>
    )}

    <section class="section">
      <h2>Repo</h2>
      <div class="card-grid">
        {category.repos.map((r) => (
          <div class="deli-card">
            <span class={`pill pill-${r.status}`}>{r.status}</span>
            <h3>{r.name}</h3>
            <p>{r.description}</p>
            <a class="repo-link" href={`https://github.com/${r.repo}`}>{r.repo} →</a>
          </div>
        ))}
      </div>
    </section>

    <div class="deli-checker" aria-hidden="true"></div>
  </div>
</Base>

<style>
  .deli-page {
    --deli-paper: #f6e7c4;
    --deli-paper-alt: #efd9a3;
    --deli-red: #b5121b;
    --deli-mustard: #c98a1f;
    --deli-ink: #3b2a18;
    --deli-line: #c9a86a;
    background: var(--deli-paper);
    color: var(--deli-ink);
    border: 1px solid var(--deli-line);
    border-radius: 12px;
    padding: 1.75rem 1.75rem 2.25rem;
    margin-top: -0.5rem;
  }
  @media (prefers-color-scheme: dark) {
    .deli-page {
      --deli-paper: #241a10;
      --deli-paper-alt: #2e2214;
      --deli-red: #e2454f;
      --deli-mustard: #e8b25a;
      --deli-ink: #f3e6c9;
      --deli-line: #5a3f22;
    }
  }
  .deli-checker {
    height: 10px;
    margin: -1.75rem -1.75rem 1.5rem;
    background: repeating-linear-gradient(
      -45deg,
      var(--deli-red),
      var(--deli-red) 10px,
      var(--deli-paper) 10px,
      var(--deli-paper) 20px
    );
    border-bottom: 1px solid var(--deli-line);
  }
  .deli-checker:last-child {
    margin: 1.75rem -1.75rem -2.25rem;
    border-bottom: none;
    border-top: 1px solid var(--deli-line);
  }
  .deli-title {
    color: var(--deli-red);
    font-weight: 800;
    letter-spacing: -0.01em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.25rem;
  }
  .deli-title-sub {
    color: var(--deli-mustard);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0;
  }
  .deli-tagline { color: var(--deli-ink); opacity: 0.75; }

  .deli-card {
    border: 1px dashed var(--deli-line);
    background: var(--deli-paper-alt);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    color: var(--deli-ink);
  }
  .deli-card h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
  .deli-card p { margin: 0 0 0.6rem; opacity: 0.8; font-size: 0.92rem; }
  .deli-card a { color: var(--deli-red); }

  .deli-page .section h2 {
    border-bottom-color: var(--deli-line);
    color: var(--deli-ink);
  }

  .deli-widget-card {
    margin-top: 1.25rem;
    background: #fff;
    border: 1px dashed var(--deli-line);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
</style>

{configured && (
  <script async src={`https://cse.google.com/cse.js?cx=${searchConfig.searchEngineId}`}></script>
)}
