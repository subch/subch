---
import Base from '../layouts/Base.astro';

// The splash is a launcher: live, fun things only. Workshop/reference pages
// live in the quiet row at the bottom.
//
// ONE REGISTER (STYLE.md sec 10 law 4). These cards are TYPE ONLY -- no
// glyphs, no per-tile hues. The old inline SVG marks with an HSL `hue` each
// were nine registers in one row, which is the note this world has spent the
// most time relearning. The wallpaper is the picture on this page; the cards
// are a printed bill on a timber panel. Do not add icons back one at a time.
const live = [
  {
    name: 'The Game Room',
    href: 'https://play.subch.us',
    action: 'Play live',
    external: true,
    blurb: 'Board & card games with real online tables — join by name, play friends on their own phones, stats that follow you.',
  },
  {
    name: 'Game Room · Road Trip',
    href: '/gameroom/',
    action: 'Play offline',
    blurb: 'The pass-and-play edition: loads once, then works with zero signal. Syncs your stats home when you’re back online.',
  },
  {
    // Straight to the table. subch.us/mtg was retired 2026-09-17: it was the
    // XMage-era front page and deck library, and every .dck it exported was
    // in XMage's format, which the Forge table cannot read. The table is its
    // own site now, with its own Discord gate on the door.
    name: 'Commander',
    href: 'https://mtg.subch.us',
    action: 'Open the table',
    external: true,
    blurb: 'Four-player Commander in the browser, every rule enforced, nothing to install. Members of the Discord only.',
  },
  {
    name: 'No Baloney',
    href: '/search/',
    action: 'Search',
    blurb: 'A search engine tuned to skip the junk and find real answers.',
  },
  {
    name: 'Goon Turismo',
    href: 'https://goon-turismo.com',
    action: 'Visit',
    external: true,
    blurb: 'Our crew’s Gran Turismo 7 time-trial results and season standings.',
  },
];

const workshop = [
  { name: '3D Printing', href: '/3d-printing/' },
  { name: 'ESP32 / Arduino', href: '/esp32-arduino/' },
  { name: 'Data Projects', href: '/data/' },
  { name: 'GitHub', href: 'https://github.com/subch' },
];
---
<Base title="Home" description="Games, a search engine that skips the junk, and the other things Travis Schaefer builds for fun. Pick one and go.">
  <section class="hero">
    <p class="kicker">subch.us · the Schaefer build shelf</p>
    <h1>Things I built<br />for the fun of it.</h1>
    <p class="lede">
      Games for the family, a search engine that skips the junk, and a few
      other live projects. Everything below works right now — pick one.
    </p>
    <div class="hero-cta">
      <a class="btn primary" href="https://play.subch.us">Play The Game Room</a>
      <a class="btn" href="/search/">Search with No Baloney</a>
    </div>
  </section>

  <section class="live">
    <h2 class="rail">Live projects</h2>
    <div class="grid">
      {live.map((p) => (
        <a
          class="proj"
          href={p.href}
          target={p.external ? '_blank' : undefined}
          rel={p.external ? 'noopener' : undefined}
        >
          <span class="name">{p.name}</span>
          <span class="blurb">{p.blurb}</span>
          <span class="go">{p.action} {p.external ? '↗' : '→'}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="workshop">
    <h2 class="rail">From the workshop</h2>
    <p>Notes, parts lists, and works-in-progress — less polished, still public.</p>
    <ul>
      {workshop.map((w) => (
        <li><a href={w.href}>{w.name}</a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding: 3.2rem 0 2.4rem;
  }
  .hero::before {
    /* The hero is the one block of running text that sits straight on the
       wallpaper -- the cards below are opaque panels. A soft pool of dark
       behind it does what a lamp does in a papered room, and it works at
       every width, which a wider page-level scrim would not on a phone. */
    content: '';
    position: absolute;
    inset: -2rem -3rem;
    z-index: -1;
    background: radial-gradient(78% 72% at 32% 45%, rgba(16, 6, 4, 0.86), rgba(16, 6, 4, 0) 72%);
    pointer-events: none;
  }
  .kicker {
    margin: 0 0 1rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    /* gold, not gold-deep: shadowed gilt disappears against the pattern */
    color: var(--gold);
  }
  .hero h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2rem, 5.6vw, 3.1rem);
    line-height: 1.16;
    color: var(--paper);
    /* Lamplight: the display face reads as gilt signwriting, not flat text. */
    text-shadow: 0 1px 0 rgba(20, 13, 8, 0.9);
  }
  .hero h1 :global(br) { display: block; }
  .lede {
    margin: 0;
    max-width: 46ch;
    font-size: 1.06rem;
    color: var(--muted);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.7rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.2rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--paper);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: border-color 0.14s ease, color 0.14s ease, background-color 0.14s ease;
  }
  .btn:hover { border-color: var(--gold); color: var(--gold-bright); }
  .btn.primary {
    background: var(--gold);
    border-color: var(--gold-bright);
    color: #140d08;
  }
  .btn.primary:hover {
    background: var(--gold-bright);
    color: #140d08;
  }

  /* ---------- section rails ---------- */
  .rail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* gold, not gold-deep. Shadowed gilt is a colour for sitting ON a panel;
       over the wallpaper it is the same value as the pattern and vanishes. */
    color: var(--gold);
    margin: 2.4rem 0 1rem;
  }
  .rail::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gold-deep), transparent);
  }

  /* ---------- live project cards ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.9rem;
  }
  .proj {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.15rem 1.2rem 1.1rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    /* Opaque panel, deliberately: the wallpaper is behind the page, not
       behind the words. A translucent card here puts a botanical branch
       through the middle of a sentence. */
    background: var(--panel);
    color: inherit;
    text-decoration: none;
    position: relative;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  .proj::before {
    /* one gilt hairline along the top edge -- the card's only ornament */
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(90deg, transparent, var(--gold-deep) 25%, var(--gold) 50%, var(--gold-deep) 75%, transparent);
    opacity: 0.7;
    transition: opacity 0.16s ease;
  }
  .proj:hover,
  .proj:focus-visible {
    border-color: rgba(217, 164, 49, 0.55);
    transform: translateY(-2px);
  }
  .proj:hover::before { opacity: 1; }
  .name {
    font-family: var(--display);
    font-size: 1.08rem;
    line-height: 1.3;
    color: var(--paper);
  }
  .blurb {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }
  .go {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .proj:hover .go { color: var(--gold-bright); }

  /* ---------- workshop row ---------- */
  .workshop { margin-top: 1rem; padding-bottom: 1rem; }
  .workshop p { margin: 0 0 0.7rem; color: var(--muted); font-size: 0.9rem; }
  .workshop ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .workshop li a {
    display: inline-block;
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.14s, border-color 0.14s;
  }
  .workshop li a:hover { color: var(--gold-bright); border-color: var(--gold); }

  @media (prefers-reduced-motion: reduce) {
    .btn, .proj, .proj::before, .go { transition: none; }
    .proj:hover { transform: none; }
  }
</style>
